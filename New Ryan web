<title>RYAN RONALD | Movies</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    scroll-behavior:smooth;
}

body{
    font-family:Arial,Helvetica,sans-serif;
    background:#03050d;
    color:white;
    overflow-x:hidden;
}

/* BACKGROUND */
body::before{
    content:"";
    position:fixed;
    inset:0;
    z-index:-3;
    background:
      radial-gradient(circle at 15% 20%,rgba(0,100,255,.25),transparent 30%),
      radial-gradient(circle at 85% 70%,rgba(255,0,45,.25),transparent 30%),
      linear-gradient(135deg,#02040a,#08000b,#02040a);
}

body::after{
    content:"";
    position:fixed;
    inset:0;
    z-index:-2;
    opacity:.15;
    background-image:
      linear-gradient(rgba(0,100,255,.25) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,0,50,.2) 1px,transparent 1px);
    background-size:45px 45px;
    animation:gridMove 15s linear infinite;
}

@keyframes gridMove{
    from{transform:translateY(0)}
    to{transform:translateY(45px)}
}

/* NAVBAR */
header{
    position:fixed;
    top:0;
    left:0;
    width:100%;
    z-index:1000;
    padding:18px 6%;
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:rgba(2,5,15,.82);
    backdrop-filter:blur(15px);
    border-bottom:1px solid rgba(0,120,255,.25);
}

.logo{
    font-size:25px;
    font-weight:900;
    letter-spacing:2px;
    color:#fff;
    text-shadow:
      0 0 5px #087cff,
      0 0 15px #087cff,
      0 0 30px #ff1744;
    animation:blink 2s infinite alternate;
}

@keyframes blink{
    from{filter:brightness(.75)}
    to{filter:brightness(1.5)}
}

nav{
    display:flex;
    gap:25px;
}

nav a{
    color:white;
    text-decoration:none;
    font-weight:bold;
    transition:.3s;
}

nav a:hover{
    color:#168cff;
    text-shadow:0 0 10px #168cff;
}

.search{
    display:flex;
    gap:8px;
}

.search input{
    width:190px;
    padding:10px 14px;
    border-radius:30px;
    border:1px solid #147cff;
    background:#050914;
    color:white;
    outline:none;
}

.search button{
    border:none;
    border-radius:50%;
    width:40px;
    height:40px;
    background:linear-gradient(135deg,#087cff,#ff1744);
    color:white;
    cursor:pointer;
}

/* HERO */
.hero{
    min-height:100vh;
    display:flex;
    align-items:center;
    padding:140px 7% 80px;
    position:relative;
}

.hero-content{
    max-width:700px;
}

.hero h1{
    font-size:clamp(45px,7vw,90px);
    line-height:.95;
    margin-bottom:25px;
}

.hero h1 span{
    background:linear-gradient(90deg,#087cff,#fff,#ff1744);
    -webkit-background-clip:text;
    color:transparent;
}

.hero p{
    color:#b9c3d8;
    font-size:18px;
    line-height:1.7;
    margin-bottom:30px;
}

.buttons{
    display:flex;
    gap:15px;
    flex-wrap:wrap;
}

.btn{
    padding:14px 25px;
    border-radius:30px;
    text-decoration:none;
    color:white;
    font-weight:bold;
    border:1px solid #168cff;
    background:#061020;
    transition:.3s;
    cursor:pointer;
}

.btn:hover{
    transform:translateY(-4px);
    box-shadow:0 0 25px #087cff;
}

.btn.primary{
    background:linear-gradient(90deg,#087cff,#ff1744);
    border:none;
}

/* SECTIONS */
section{
    padding:80px 6%;
}

.section-title{
    font-size:38px;
    margin-bottom:35px;
}

.section-title span{
    color:#168cff;
}

/* FILTERS */
.filters{
    display:flex;
    flex-wrap:wrap;
    gap:10px;
    margin-bottom:35px;
}

.filter{
    padding:10px 20px;
    border:1px solid #123c70;
    background:#07101e;
    color:#ddd;
    border-radius:25px;
    cursor:pointer;
    transition:.3s;
}

.filter:hover,
.filter.active{
    background:linear-gradient(90deg,#087cff,#ff1744);
    color:white;
    border-color:transparent;
}

/* MOVIE GRID */
.movie-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(190px,1fr));
    gap:25px;
}

.movie{
    background:rgba(8,12,25,.85);
    border:1px solid rgba(30,120,255,.25);
    border-radius:18px;
    overflow:hidden;
    transition:.4s;
    position:relative;
}

.movie:hover{
    transform:translateY(-10px) scale(1.02);
    border-color:#087cff;
    box-shadow:
      0 0 20px rgba(0,110,255,.3),
      0 0 30px rgba(255,0,50,.15);
}

.poster{
    height:285px;
    overflow:hidden;
}

.poster img{
    width:100%;
    height:100%;
    object-fit:cover;
    transition:.5s;
}

.movie:hover .poster img{
    transform:scale(1.1);
}

.movie-info{
    padding:16px;
}

.movie-info h3{
    font-size:18px;
    margin-bottom:7px;
}

.movie-info p{
    color:#8f9bb2;
    font-size:13px;
    margin-bottom:13px;
}

.trailer-btn{
    width:100%;
    padding:10px;
    border:none;
    border-radius:20px;
    background:linear-gradient(90deg,#087cff,#ff1744);
    color:white;
    font-weight:bold;
    cursor:pointer;
}

/* FEATURED */
.featured{
    background:
      linear-gradient(90deg,rgba(0,80,255,.18),rgba(255,0,50,.15)),
      rgba(5,8,18,.8);
    border-top:1px solid rgba(0,120,255,.2);
    border-bottom:1px solid rgba(255,0,50,.2);
}

.feature-box{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:40px;
    align-items:center;
}

.feature-box img{
    width:100%;
    border-radius:20px;
    box-shadow:0 0 40px rgba(0,110,255,.25);
}

.feature-box h2{
    font-size:45px;
    margin-bottom:15px;
}

.feature-box p{
    color:#b4bfd2;
    line-height:1.7;
}

/* MODAL */
.modal{
    display:none;
    position:fixed;
    inset:0;
    z-index:3000;
    background:rgba(0,0,0,.9);
    align-items:center;
    justify-content:center;
    padding:20px;
}

.modal.active{
    display:flex;
}

.modal-box{
    width:min(900px,100%);
    background:#060a15;
    border:1px solid #087cff;
    border-radius:20px;
    padding:15px;
    box-shadow:0 0 50px rgba(0,100,255,.3);
    position:relative;
}

.modal iframe{
    width:100%;
    height:500px;
    border:none;
    border-radius:12px;
}

.close{
    position:absolute;
    right:-10px;
    top:-15px;
    width:40px;
    height:40px;
    border-radius:50%;
    border:none;
    background:#ff1744;
    color:white;
    font-size:22px;
    cursor:pointer;
}

/* ABOUT */
.about{
    text-align:center;
    max-width:850px;
    margin:auto;
}

.about p{
    color:#aab5c9;
    line-height:1.8;
}

/* FOOTER */
footer{
    text-align:center;
    padding:35px;
    border-top:1px solid rgba(0,100,255,.2);
    color:#7f8ba2;
}

footer strong{
    color:#168cff;
}

/* MOBILE */
@media(max-width:800px){
    header{
        flex-wrap:wrap;
        gap:15px;
    }

