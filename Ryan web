* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #030706;
    color: white;
    overflow-x: hidden;
}

/* ================= BACKGROUND ================= */

body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: -5;
    background:
        radial-gradient(circle at 15% 20%, rgba(0,255,100,.14), transparent 25%),
        radial-gradient(circle at 85% 30%, rgba(0,255,180,.10), transparent 25%),
        radial-gradient(circle at 50% 90%, rgba(0,255,100,.08), transparent 30%),
        #030706;
}

body::after {
    content: "";
    position: fixed;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: rgba(0,255,100,.08);
    filter: blur(100px);
    top: 10%;
    left: -150px;
    animation: floatGlow 8s infinite alternate ease-in-out;
    z-index: -4;
}

@keyframes floatGlow {
    from {
        transform: translate(0,0);
    }
    to {
        transform: translate(100vw,250px);
    }
}

/* animated grid */

.grid-bg {
    position: fixed;
    inset: 0;
    z-index: -3;
    opacity: .16;
    background-image:
        linear-gradient(rgba(0,255,100,.12) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,255,100,.12) 1px, transparent 1px);
    background-size: 50px 50px;
    animation: gridMove 15s linear infinite;
}

@keyframes gridMove {
    from {
        background-position: 0 0;
    }
    to {
        background-position: 50px 50px;
    }
}

/* ================= NAVBAR ================= */

header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 15px 6%;
    background: rgba(0,0,0,.72);
    backdrop-filter: blur(15px);
    border-bottom: 1px solid rgba(0,255,100,.18);
}

.navbar {
    max-width: 1400px;
    margin: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

/* LOGO */

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: white;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: 1px;
}

.logo-icon {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    background: #00ff66;
    color: #001b0a;
    box-shadow:
        0 0 10px #00ff66,
        0 0 25px #00ff66,
        0 0 50px rgba(0,255,102,.6);
    animation: logoBlink 1.4s infinite alternate;
}

@keyframes logoBlink {
    0% {
        opacity: .65;
        transform: scale(1);
        box-shadow: 0 0 8px #00ff66;
    }

    100% {
        opacity: 1;
        transform: scale(1.07);
        box-shadow:
            0 0 15px #00ff66,
            0 0 35px #00ff66,
            0 0 70px rgba(0,255,102,.7);
    }
}

.logo span {
    color: #00ff66;
    text-shadow: 0 0 15px rgba(0,255,100,.7);
}

nav {
    display: flex;
    align-items: center;
    gap: 25px;
}

nav a {
    color: #ddd;
    text-decoration: none;
    font-size: 14px;
    font-weight: 700;
    transition: .3s;
}

nav a:hover {
    color: #00ff66;
    text-shadow: 0 0 10px #00ff66;
}

/* search */

.search-box {
    display: flex;
    align-items: center;
    background: rgba(255,255,255,.06);
    border: 1px solid rgba(0,255,100,.25);
    border-radius: 30px;
    padding: 7px 13px;
}

.search-box input {
    width: 150px;
    background: transparent;
    border: none;
    outline: none;
    color: white;
    font-size: 13px;
}

.search-box button {
    background: none;
    border: none;
    color: #00ff66;
    cursor: pointer;
    font-size: 17px;
}

/* ================= HERO ================= */

.hero {
    min-height: 720px;
    padding: 160px 7% 90px;
    display: flex;
    align-items: center;
    position: relative;
    overflow: hidden;
}

.hero-content {
    max-width: 750px;
}

.badge {
    display: inline-block;
    color: #00ff66;
    border: 1px solid rgba(0,255,100,.35);
    background: rgba(0,255,100,.06);
    padding: 8px 15px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: bold;
    letter-spacing: 2px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: clamp(50px, 8vw, 100px);
    line-height: .9;
    margin-bottom: 25px;
}

.hero h1 span {
    color: #00ff66;
    text-shadow:
        0 0 10px #00ff66,
        0 0 30px rgba(0,255,100,.6);
}

.hero p {
    max-width: 600px;
    color: #aaa;
    font-size: 17px;
    line-height: 1.7;
    margin-bottom: 30px;
}

.hero-buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 23px;
    border-radius: 30px;
    text-decoration: none;
    font-weight: 800;
    border: 1px solid #00ff66;
    transition: .3s;
    cursor: pointer;
}

.btn-primary {
    background: #00ff66;
    color: #001b0a;
    box-shadow: 0 0 20px rgba(0,255,100,.35);
}

.btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 35px rgba(0,255,100,.7);
}

.btn-secondary {
    color: white;
    background: rgba(255,255,255,.05);
}

.btn-secondary:hover {
    background: rgba(0,255,100,.1);
    color: #00ff66;
}

/* hero decoration */

.hero-orb {
    position: absolute;
    right: 8%;
    width: 350px;
    height: 350px;
    border-radius: 50%;
    border: 1px solid rgba(0,255,100,.25);
    box-shadow:
        0 0 60px rgba(0,255,100,.12),
        inset 0 0 50px rgba(0,255,100,.08);
    animation: orb 7s infinite alternate ease-in-out;
}

.hero-orb::before,
.hero-orb::after {
    content: "";
    position: absolute;
    inset: 35px;
    border: 1px solid rgba(0,255,100,.18);
    border-radius: 50%;
}

.hero-orb::after {
    inset: 90px;
}

@keyframes orb {
    from {
        transform: translateY(-25px) rotate(0deg);
    }

    to {
        transform: translateY(25px) rotate(25deg);
    }
}

/* ================= SECTIONS ================= */

section {
    padding: 80px 6%;
}

.section-title {
    max-width: 1400px;
    margin: auto auto 30px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
}

.section-title h2 {
    font-size: 32px;
}

.section-title h2 span {
    color: #00ff66;
}

.section-title p {
    color: #777;
}

/* ================= FILTER ================= */

.filters {
    max-width: 1400px;
    margin: 0 auto 35px;
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.filter-btn {
    padding: 9px 17px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 30px;
    background: rgba(255,255,255,.04);
    color: #aaa;
    cursor: pointer;
    transition: .3s;
}

.filter-btn:hover,
.filter-btn.active {
    background: #00ff66;
    color: #001b0a;
    border-color: #00ff66;
}

/* ================= MOVIES ================= */

.movie-grid {
    max-width: 1400px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 22px;
}

.movie-card {
    background: rgba(255,255,255,.045);
    border: 1px solid rgba(255,255,255,.08);
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    transition: .35s;
}

.movie-card:hover {
    transform: translateY(-8px);
    border-color: rgba(0,255,100,.5);
    box-shadow: 0 15px 40px rgba(0,0,0,.5);
}

.poster {
    height: 285px;
    position: relative;
    overflow: hidden;
}

.poster img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: .5s;
}

.movie-card:hover .poster img {
    transform: scale(1.08);
}

.poster::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 45%, rgba(0,0,0,.9));
}

.movie-info {
    padding: 15px;
}

.movie-info h3 {
