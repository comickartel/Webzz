    ====================================================== -->

    <div class="input-area">

        <div class="input-box">

            <input
                id="userInput"
                type="text"
                autocomplete="off"
                placeholder="Ask CyberAI a cybersecurity question..."
            >

            <button id="sendBtn">
                ➤
            </button>

        </div>

        <div class="footer">
            CYBERAI • Cybersecurity Education • Defensive Security
        </div>

    </div>

</div>


<script>

/* =========================================================
   CYBERAI — JAVASCRIPT
========================================================= */


/* =========================================================
   PARTICLES
========================================================= */

const particles =
    document.getElementById("particles");

for (let i = 0; i < 70; i++) {

    const particle =
        document.createElement("div");

    particle.className =
        "particle";

    particle.style.left =
        Math.random() * 100 + "%";

    particle.style.animationDuration =
        (5 + Math.random() * 12) + "s";

    particle.style.animationDelay =
        (-Math.random() * 12) + "s";

    const size =
        2 + Math.random() * 3;

    particle.style.width =
        size + "px";

    particle.style.height =
        size + "px";

    particles.appendChild(
        particle
    );
}


/* =========================================================
   ELEMENTS
========================================================= */

const chat =
    document.getElementById("chat");

const input =
    document.getElementById("userInput");

const sendBtn =
    document.getElementById("sendBtn");


/* =========================================================
   ESCAPE USER INPUT
========================================================= */

function escapeHTML(text) {

    const div =
        document.createElement("div");

    div.textContent =
        text;

    return div.innerHTML;
}


/* =========================================================
   ADD MESSAGE
========================================================= */

function addMessage(
    text,
    type = "bot"
) {

    const message =
        document.createElement("div");

    message.className =
        "message " + type;

    const avatar =
        type === "bot"
            ? "🛡️"
            : "👤";

    message.innerHTML = `

        <div class="avatar">
            ${avatar}
        </div>

        <div class="bubble">
            ${text}
        </div>

    `;

    chat.appendChild(
        message
    );

    chat.scrollTop =
        chat.scrollHeight;
}


/* =========================================================
   TYPING INDICATOR
========================================================= */

function showTyping() {

    const message =
        document.createElement("div");

    message.className =
        "message bot";

    message.id =
        "typingMessage";

    message.innerHTML = `

        <div class="avatar">
            🛡️
        </div>

        <div class="bubble">

            <div class="typing">

                <span></span>
                <span></span>
                <span></span>

            </div>

        </div>

    `;

    chat.appendChild(
        message
    );

    chat.scrollTop =
        chat.scrollHeight;
}


function removeTyping() {

    const typing =
        document.getElementById(
            "typingMessage"
        );

    if (typing) {
        typing.remove();
    }
}


/* =========================================================
   SAFE CYBERSECURITY KNOWLEDGE BASE
========================================================= */

const knowledge = [

    {
        keywords: [
            "ethical hacking",
            "ethical hacker"
        ],

        answer: `
        🛡️ <strong>Ethical Hacking</strong>

        <br><br>

        Ethical hacking is authorized security
        testing performed to identify and help
        fix vulnerabilities.

        <br><br>

        A legitimate assessment normally has:

        <br><br>

        • Permission from the system owner<br>
        • A defined scope<br>
        • Testing rules<br>
        • Documentation<br>
        • Responsible reporting

        <br><br>

        Practice on systems you own or on
        intentionally vulnerable labs and CTFs.
        `
    },


    {
        keywords: [
            "sql injection",
            "sqli"
        ],

        answer: `
        🕸️ <strong>SQL Injection</strong>

        <br><br>

        SQL injection occurs when untrusted input
        is incorrectly incorporated into database
        queries.

        <br><br>

        Potential consequences include unauthorized
        access to application data or modification
        of database information.

        <br><br>

        🛡️ <strong>Defenses:</strong>

        <br>

        • Parameterized queries<br>
        • Prepared statements<br>
        • Input validation<br>
        • Least-privilege database accounts<br>
        • Secure error handling

        <br><br>

        You can safely practice this concept in
        intentionally vulnerable web-security labs.
        `
    },


    {
        keywords: [
            "xss",
            "cross site scripting"
        ],

        answer: `
        🕸️ <strong>Cross-Site Scripting (XSS)</strong>

        <br><br>

        XSS is a web-security vulnerability where
        attacker-controlled content can be interpreted
        as script in another user's browser.

        <br><br>

        Common defenses include:

        <br><br>

        • Context-aware output encoding<br>
        • Input validation<br>
        • Content Security Policy<br>
        • Safe templating systems<br>
        • Avoiding unsafe HTML injection

        `
    },


    {
        keywords: [
            "password",
            "passwords"
        ],

        answer: `
        🔐 <strong>Password Security</strong>

        <br><br>

        Good password security includes:

        <br><br>

        • Long unique passwords<br>
        • A password manager<br>
        • Multi-factor authentication<br>
        • Protection against credential reuse<br>
        • Secure password hashing on servers

        <br><br>

        Modern systems should use dedicated
        password-hashing algorithms rather than
        storing plaintext passwords.
        `
    },


    {
        keywords: [
            "network security",
            "network"
        ],

        answer: `
        🌐 <strong>Network Security</strong>

        <br><br>

        Network security protects systems and
        communications from unauthorized access
        and abuse.

        <br><br>

        Important concepts include:

        <br><br>

        • Firewalls<br>
        • Network segmentation<br>
        • Secure protocols<br>
        • Access control<br>
        • Monitoring and logging<br>
        • Patch management
        `
    },


    {
        keywords: [
            "ctf",
            "capture the flag"
        ],

        answer: `
        🧪 <strong>Capture The Flag</strong>

        <br><br>

        CTFs are security competitions where
        participants solve intentionally designed
        challenges.

        <br><br>

        Common categories include:

        <br><br>

        🔐 Cryptography<br>
        🌐 Web security<br>
        🔎 Forensics<br>
        💻 Reverse engineering<br>
        🧩 Miscellaneous puzzles

        <br><br>

        CTF platforms are a good way to practice
        security skills in authorized environments.
        `
    },


    {
        keywords: [
            "malware",
            "malware analysis"
        ],

        answer: `
        🐛 <strong>Malware Analysis</strong>

        <br><br>

        Malware analysis examines malicious software
        to understand its behavior and indicators.

        <br><br>

        Two broad approaches are:

        <br><br>

        <strong>Static analysis</strong> — examining a
        sample without executing it.

        <br><br>

        <strong>Dynamic analysis</strong> — observing
        behavior inside an isolated analysis environment.

        <br><br>

        Malware should be handled in properly
        isolated environments.
        `
    },


    {
        keywords: [
            "phishing"
        ],

        answer: `
        🎣 <strong>Phishing</strong>

        <br><br>

        Phishing attempts to trick people into
        revealing information or performing an
        unwanted action.

        <br><br>

        Defensive practices include:

        <br><br>

        • Checking unexpected links<br>
