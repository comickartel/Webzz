/* =========================================================
   SEND
========================================================= */

async function sendMessage() {

    const question =
        input.value.trim();

    if (!question) {
        return;
    }

    addUserMessage(question);

    input.value = "";

    showTyping();

    /*
     * Simulated intelligence processing.
     */

    const delay =
        450 +
        Math.random() * 850;

    await new Promise(
        resolve =>
            setTimeout(
                resolve,
                delay
            )
    );

    removeTyping();

    let result =
        findBestAnswer(question);

    if (!result) {

        result =
            genericResponse(question);
    }

    addBotMessage(result);

    saveChat();
}


