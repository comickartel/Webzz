/* =========================================================
   MATCHING ENGINE
========================================================= */

function findBestAnswer(question) {

    if (isUnsafeRequest(question)) {
        return safetyResponse();
    }

    const q =
        question
            .toLowerCase()
            .replace(/[^\w\s-]/g, " ");

    let best = null;
    let bestScore = 0;

    for (const item of knowledge) {

        let score = 0;

        for (const keyword of item.keywords) {

            const key =
                keyword.toLowerCase();

            if (q.includes(key)) {

                score +=
                    key.length > 5
                        ? 3
                        : 2;
            }
        }

        /*
         * Module-related bonus
         */

        if (
            q.includes(
                item.module.toLowerCase()
            )
        ) {
            score += 2;
        }

        if (score > bestScore) {

            bestScore = score;
            best = item;

        }
    }

    return best;
}


