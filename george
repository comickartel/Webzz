<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CYBERAI // Command Console</title>

<style>
/* =========================================================
   CYBERAI // COMMAND CONSOLE v2
========================================================= */

:root {
    --cyan: #00f5ff;
    --cyan2: #00a8ff;
    --green: #39ff88;
    --blue: #168cff;
    --purple: #9b5cff;
    --yellow: #ffe66d;
    --orange: #ff9d3d;
    --red: #ff3d71;

    --bg: #020609;
    --panel: rgba(3, 14, 20, .91);
    --panel2: rgba(5, 21, 29, .92);

    --border: rgba(0,245,255,.19);
    --border-bright: rgba(0,245,255,.48);

    --text: #eaffff;
    --muted: #66858d;
    --muted2: #41636b;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    overflow-x: hidden;

    font-family:
        Inter,
        ui-sans-serif,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    color: var(--text);
    background: var(--bg);
}

/* =========================================================
   BACKGROUND
========================================================= */

.background {
    position: fixed;
    inset: 0;
    z-index: -20;
    overflow: hidden;

    background:
        radial-gradient(
            circle at 50% 10%,
            rgba(0,245,255,.11),
            transparent 30%
        ),
        radial-gradient(
            circle at 5% 90%,
            rgba(57,255,136,.07),
            transparent 27%
        ),
        radial-gradient(
            circle at 100% 50%,
            rgba(22,140,255,.07),
            transparent 25%
        ),
        linear-gradient(
            135deg,
            #02070a,
            #010304 70%
        );
}

.scanlines {
    position: absolute;
    inset: 0;

    background:
        repeating-linear-gradient(
            to bottom,
            transparent 0,
            transparent 3px,
            rgba(0,255,255,.018) 4px
        );

    pointer-events: none;
}

.grid {
    position: absolute;

    width: 180%;
    height: 100%;

    left: -40%;
    top: 30%;

    opacity: .13;

    background-image:
        linear-gradient(
            rgba(0,245,255,.16) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(0,245,255,.16) 1px,
            transparent 1px
        );

    background-size: 48px 48px;

    transform:
        perspective(650px)
        rotateX(62deg);

    transform-origin: center top;

    animation: gridMove 7s linear infinite;
}

@keyframes gridMove {
    from {
        transform:
            perspective(650px)
            rotateX(62deg)
            translateY(0);
    }

    to {
        transform:
            perspective(650px)
            rotateX(62deg)
            translateY(48px);
    }
}

.glow {
    position: absolute;

    width: 500px;
    height: 500px;

    border-radius: 50%;

    filter: blur(130px);

    opacity: .22;

    animation: glowMove 11s ease-in-out infinite alternate;
}

.glow.one {
    left: -220px;
    top: -220px;
    background: #00d9ff;
}

.glow.two {
    right: -240px;
    bottom: -230px;
    background: #0055ff;
    animation-delay: 2s;
}

@keyframes glowMove {
    from {
        transform: translate(0,0) scale(1);
    }

    to {
        transform: translate(90px,70px) scale(1.22);
    }
}

/* =========================================================
   PARTICLES
========================================================= */

.particles {
    position: fixed;
    inset: 0;
    z-index: -10;
    pointer-events: none;
}

.particle {
    position: absolute;

    width: 2px;
    height: 2px;

    background: var(--cyan);

    border-radius: 50%;

    box-shadow:
        0 0 9px var(--cyan);

    animation:
        particleUp linear infinite;
}

@keyframes particleUp {
    from {
        transform: translateY(110vh);
        opacity: 0;
    }

    20% {
        opacity: .8;
    }

    80% {
        opacity: .3;
    }

    to {
        transform: translateY(-10vh);
        opacity: 0;
    }
}

/* =========================================================
   APP
========================================================= */

.app {
    width: min(1180px, 95%);
    min-height: 94vh;

    margin: 3vh auto;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    background:
        linear-gradient(
            145deg,
            rgba(5,20,27,.94),
            rgba(2,9,13,.94)
        );

    border: 1px solid var(--border);

    border-radius: 22px;

    backdrop-filter: blur(22px);

    box-shadow:
        0 0 80px rgba(0,220,255,.07),
        0 30px 100px rgba(0,0,0,.45),
        inset 0 0 70px rgba(0,245,255,.018);
}

/* =========================================================
   TOP BAR
========================================================= */

.topbar {
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 16px;

    color: var(--muted);

    font-family:
        "Courier New",
        monospace;

    font-size: 10px;
    letter-spacing: 1.2px;

    border-bottom:
        1px solid rgba(0,245,255,.08);

    background:
        rgba(0,0,0,.2);
}

.topbar-left,
.topbar-right {
    display: flex;
    align-items: center;
    gap: 12px;
}

.system-dot {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: var(--green);

    box-shadow:
        0 0 10px var(--green);
}

/* =========================================================
   HEADER
========================================================= */

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 18px 22px;

    border-bottom:
        1px solid var(--border);

    background:
        rgba(2,11,16,.76);
}

.brand {
    display: flex;
    align-items: center;
    gap: 15px;
}

/* =========================================================
   SHIELD
========================================================= */

.logo {
    position: relative;

    width: 57px;
    height: 64px;

    flex-shrink: 0;

    clip-path:
        polygon(
            50% 0,
            94% 16%,
            87% 70%,
            50% 100%,
            13% 70%,
            6% 16%
        );

    background:
        linear-gradient(
            145deg,
            #00f5ff,
            #0874ff 47%,
            #07151f 48%
        );

    filter:
        drop-shadow(0 0 7px #00cfff)
        drop-shadow(0 0 18px rgba(0,245,255,.35));

    animation:
        shieldPulse 3s infinite;
}

.logo::before {
    content: "";

    position: absolute;
    inset: 7px;

    clip-path:
        polygon(
            50% 0,
            94% 16%,
            87% 70%,
            50% 100%,
            13% 70%,
            6% 16%
        );

    background: #061017;
}

.logo::after {
    content: "01";

    position: absolute;

    left: 13px;
    top: 22px;

    color: var(--cyan);

    font-family:
        "Courier New",
        monospace;

    font-size: 12px;
    font-weight: bold;

    letter-spacing: 2px;

    text-shadow:
        0 0 8px var(--cyan);

    animation: flicker 2s infinite;
}

@keyframes shieldPulse {
    0%, 85%, 100% {
        transform: scale(1);
    }

    90% {
        transform: scale(1.08);

        filter:
            brightness(1.7)
            drop-shadow(0 0 10px var(--cyan))
            drop-shadow(0 0 30px #008cff);
    }
}

@keyframes flicker {
    0%, 90%, 100% {
        opacity: 1;
    }

    93% {
        opacity: .25;
    }

    96% {
        opacity: 1;
    }
}

.brand h1 {
    font-size: 24px;
    letter-spacing: 4px;

    font-family:
        "Courier New",
        monospace;
}

.brand h1 span {
    color: var(--cyan);

    text-shadow:
        0 0 8px var(--cyan),
        0 0 22px rgba(0,245,255,.45);
}

.brand small {
    display: block;

    margin-top: 4px;

    color: var(--muted);

    font-family:
        "Courier New",
        monospace;

    font-size: 10px;

    letter-spacing: 1px;
}

/* =========================================================
   STATUS
========================================================= */

.status {
    display: flex;
    align-items: center;
    gap: 9px;

    padding: 8px 12px;

    color: var(--green);

    border:
        1px solid rgba(57,255,136,.16);

    border-radius: 999px;

    background:
        rgba(57,255,136,.035);

    font-family:
        "Courier New",
        monospace;

    font-size: 10px;

    letter-spacing: 1.4px;
}

.status-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: var(--green);

    box-shadow:
        0 0 12px var(--green);

    animation:
        statusPulse 1.2s infinite;
}

@keyframes statusPulse {
    50% {
        opacity: .3;
        transform: scale(.65);
    }
}

/* =========================================================
   MODULE BAR
========================================================= */

.modules {
    display: flex;
    gap: 7px;

    padding: 10px 20px;

    overflow-x: auto;

    border-bottom:
        1px solid rgba(0,245,255,.08);

    background:
        rgba(0,0,0,.13);
}

.module {
    flex-shrink: 0;

    padding: 5px 9px;

    color: #6d9ca4;

    border:
        1px solid rgba(0,245,255,.08);

    border-radius: 5px;

    font-family:
        "Courier New",
        monospace;

    font-size: 9px;

    letter-spacing: .7px;

    transition: .2s;
}

.module.active {
    color: var(--cyan);

    border-color:
        rgba(0,245,255,.3);

    background:
        rgba(0,245,255,.04);

    box-shadow:
        0 0 12px rgba(0,245,255,.07);
}

/* =========================================================
   TOOLBAR
========================================================= */

.toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 9px 20px;

    border-bottom:
        1px solid rgba(0,245,255,.07);

    color: var(--muted);

    font-family:
        "Courier New",
        monospace;

    font-size: 9px;
}

.toolbar-left {
    display: flex;
    gap: 10px;
}

.tool-btn {
    padding: 5px 9px;

    color: #6d969e;

    background: transparent;

    border:
        1px solid rgba(0,245,255,.1);

    border-radius: 5px;

    cursor: pointer;

    font-family: inherit;
    font-size: 9px;

    transition: .2s;
}

.tool-btn:hover {
    color: var(--cyan);

    border-color:
        rgba(0,245,255,.35);

    background:
        rgba(0,245,255,.04);
}

.session {
    color: #36555c;
}

/* =========================================================
   CHAT
========================================================= */

.chat {
    flex: 1;

    min-height: 500px;

    overflow-y: auto;

    padding: 27px 25px;

    scroll-behavior: smooth;
}

.chat::-webkit-scrollbar {
    width: 6px;
}

.chat::-webkit-scrollbar-track {
    background: transparent;
}

.chat::-webkit-scrollbar-thumb {
    background: #123b43;
    border-radius: 20px;
}

.message {
    display: flex;
    gap: 11px;

    margin-bottom: 22px;

    animation:
        messageIn .28s ease;
}

@keyframes messageIn {
    from {
        opacity: 0;
        transform: translateY(9px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.message.user {
    justify-content: flex-end;
}

.avatar {
    width: 38px;
    height: 38px;

    flex-shrink: 0;

    display: grid;
    place-items: center;

    border-radius: 9px;

    background:
        #071c23;

    border:
        1px solid rgba(0,245,255,.32);

    box-shadow:
        0 0 15px rgba(0,245,255,.09);

    font-size: 17px;
}

.user .avatar {
    order: 2;

    background: #0b1724;

    border-color:
        rgba(60,150,255,.35);
}

.bubble {
    position: relative;

    max-width: min(780px, 84%);

    padding: 15px 17px;

    color: #d9eeee;

    line-height: 1.62;

    font-size: 14px;

    background:
        linear-gradient(
            145deg,
            rgba(7,27,34,.92),
            rgba(4,18,24,.92)
        );

    border:
        1px solid rgba(0,245,255,.11);

    border-radius: 5px 15px 15px 15px;

    box-shadow:
        0 12px 35px rgba(0,0,0,.18);
}

.user .bubble {
    background:
        linear-gradient(
            145deg,
            rgba(10,31,50,.95),
            rgba(6,20,35,.95)
        );

    border:
        1px solid rgba(60,150,255,.2);

    border-radius:
        15px 5px 15px 15px;
}

.bot-label {
    margin-bottom: 8px;

    color: var(--cyan);

    font-family:
        "Courier New",
        monospace;

    font-size: 10px;
    font-weight: bold;

    letter-spacing: 1.3px;
}

.user-label {
    margin-bottom: 7px;

    color: #70aaff;

    font-family:
        "Courier New",
        monospace;

    font-size: 9px;
}

.bubble strong {
    color: var(--cyan);

    text-shadow:
        0 0 7px rgba(0,245,255,.22);
}

.bubble em {
    color: #9dc8ce;
}

.bubble code {
    padding: 2px 6px;

    color: #63ffc2;

    background:
        rgba(0,0,0,.38);

    border:
        1px solid rgba(57,255,136,.12);

    border-radius: 4px;

    font-family:
        "Courier New",
        monospace;

    font-size: .9em;
}

/* =========================================================
   CYBER RESPONSE COMPONENTS
========================================================= */

.response-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 10px;

    margin-bottom: 12px;
}

.module-tag {
    display: inline-block;

    padding: 5px 8px;

    color: var(--cyan);

    background:
        rgba(0,245,255,.045);

    border:
        1px solid rgba(0,245,255,.19);

    border-radius: 4px;

    font-family:
        "Courier New",
        monospace;

    font-size: 9px;

    letter-spacing: 1px;
}

.threat {
    padding: 4px 7px;

    border-radius: 4px;

    font-family:
        "Courier New",
        monospace;

    font-size: 8px;

    letter-spacing: 1px;
}

.threat.info {
    color: var(--green);
    border: 1px solid rgba(57,255,136,.2);
    background: rgba(57,255,136,.04);
}

.threat.medium {
    color: var(--yellow);
    border: 1px solid rgba(255,230,109,.2);
    background: rgba(255,230,109,.04);
}

.threat.high {
    color: var(--red);
    border: 1px solid rgba(255,61,113,.2);
    background: rgba(255,61,113,.04);
}

.cyber-title {
    margin-bottom: 8px;

    color: white;

    font-size: 16px;
    font-weight: 700;

    letter-spacing: .3px;
}

.vocab {
    margin: 13px 0;

    padding: 12px;

    background:
        rgba(0,0,0,.18);

    border-left:
        2px solid var(--cyan);

    font-family:
        "Courier New",
        monospace;

    font-size: 11px;
}

.vocab-row {
    display: grid;
    grid-template-columns: 145px 1fr;

    gap: 10px;

    margin: 5px 0;
}

.vocab-key {
    color: var(--green);
}

.vocab-value {
    color: #8eafb5;
}

.tip {
    margin-top: 14px;

    padding: 11px 13px;

    color: #b9dfe3;

    background:
        linear-gradient(
            90deg,
            rgba(57,255,136,.05),
            transparent
        );

    border-left:
        2px solid var(--green);

    font-size: 12px;
}

.tip b {
    color: var(--green);
}

/* =========================================================
   TYPING
========================================================= */

.typing-row {
    display: flex;
    align-items: center;
    gap: 10px;

    color: #547b83;

    font-family:
        "Courier New",
        monospace;

    font-size: 9px;

    letter-spacing: 1px;
}

.typing {
    display: flex;
    gap: 4px;
}

.typing span {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: var(--cyan);

    box-shadow:
        0 0 8px var(--cyan);

    animation:
        typing 1s infinite;
}

.typing span:nth-child(2) {
    animation-delay: .15s;
}

.typing span:nth-child(3) {
    animation-delay: .3s;
}

@keyframes typing {
    0%, 60%, 100% {
        transform: translateY(0);
        opacity: .25;
    }

    30% {
        transform: translateY(-5px);
        opacity: 1;
    }
}

/* =========================================================
   SUGGESTIONS
========================================================= */

.suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;

    padding:
        0 25px 14px;
}

.suggestion {
    padding: 8px 11px;

    color: #91d0d6;

    background:
        rgba(6,29,35,.62);

    border:
        1px solid rgba(0,245,255,.12);

    border-radius: 5px;

    cursor: pointer;

    font-family:
        "Courier New",
        monospace;

    font-size: 10px;

    transition: .2s;
}

.suggestion:hover {
    color: white;

    border-color:
        var(--cyan);

    background:
        rgba(0,100,120,.3);

    box-shadow:
        0 0 17px rgba(0,245,255,.13);

    transform:
        translateY(-2px);
}

/* =========================================================
   INPUT
========================================================= */

.input-area {
    padding:
        17px 22px 20px;

    border-top:
        1px solid rgba(0,245,255,.11);

    background:
        rgba(1,8,12,.82);
}

.input-box {
    display: flex;
    gap: 9px;

    padding: 7px;

    background:
        rgba(4,20,26,.96);

    border:
        1px solid rgba(0,245,255,.19);

    border-radius: 10px;

    transition: .2s;
}

.input-box:focus-within {
    border-color:
        rgba(0,245,255,.65);

    box-shadow:
        0 0 25px rgba(0,245,255,.08);
}

.prompt {
    display: flex;
    align-items: center;

    padding-left: 9px;

    color: var(--green);

    font-family:
        "Courier New",
        monospace;

    font-size: 12px;
}

#userInput {
    flex: 1;

    min-width: 0;

    padding: 12px 7px;

    color: white;

    background: transparent;

    border: none;
    outline: none;

    font-size: 14px;
}

#userInput::placeholder {
    color: #45666e;
}

#sendBtn {
    width: 49px;
    height: 44px;

    flex-shrink: 0;

    border: none;
    border-radius: 8px;

    color: #001012;

    background:
        linear-gradient(
            135deg,
            var(--cyan),
            var(--green)
        );

    cursor: pointer;

    font-size: 19px;
    font-weight: bold;

    box-shadow:
        0 0 18px rgba(0,245,255,.23);

    transition: .2s;
}

#sendBtn:hover {
    transform: scale(1.05);

    box-shadow:
        0 0 28px rgba(0,245,255,.5);
}

#sendBtn:active {
    transform: scale(.94);
}

.footer {
    display: flex;
    justify-content: space-between;

    margin-top: 8px;

    color: #365158;

    font-family:
        "Courier New",
        monospace;

    font-size: 8px;

    letter-spacing: .7px;
}

/* =========================================================
   MOBILE
========================================================= */

@media(max-width: 700px) {

    .app {
        width: 100%;
        min-height: 100vh;

        margin: 0;

        border-radius: 0;
    }

    .topbar-right {
        display: none;
    }

    .header {
        padding: 14px;
    }

    .brand h1 {
        font-size: 19px;
    }

    .brand small {
        font-size: 8px;
    }

    .logo {
        width: 47px;
        height: 53px;
    }

    .status {
        padding: 7px;
    }

    .status span:last-child {
        display: none;
    }

    .toolbar {
        padding: 8px 13px;
    }

    .chat {
        padding: 18px 13px;
    }

    .suggestions {
        padding:
            0 13px 12px;
    }

    .input-area {
        padding: 12px;
    }

    .bubble {
        max-width: 89%;
        font-size: 13px;
    }

    .vocab-row {
        grid-template-columns: 1fr;
        gap: 2px;
    }

    .footer {
        display: none;
    }
}
</style>
</head>

<body>

<!-- =========================================================
     BACKGROUND
========================================================= -->

<div class="background">
    <div class="grid"></div>
    <div class="glow one"></div>
    <div class="glow two"></div>
    <div class="scanlines"></div>
</div>

<div class="particles" id="particles"></div>


<!-- =========================================================
     APPLICATION
========================================================= -->

<div class="app">

    <!-- TOP SYSTEM BAR -->

    <div class="topbar">

        <div class="topbar-left">
            <span class="system-dot"></span>
            <span>CYBERAI://CORE</span>
            <span id="clock">00:00:00</span>
        </div>

        <div class="topbar-right">
            <span>ENCRYPTED SESSION</span>
            <span>NODE: LOCAL</span>
            <span>BUILD 2.0.0</span>
        </div>

    </div>


    <!-- HEADER -->

    <header class="header">

        <div class="brand">

            <div class="logo"></div>

            <div>

                <h1>
                    <span>CYBER</span>AI
                </h1>

                <small>
                    SECURITY INTELLIGENCE // COMMAND CONSOLE
                </small>

            </div>

        </div>

        <div class="status">

            <span class="status-dot"></span>

            <span>CORE ONLINE</span>

        </div>

    </header>


    <!-- MODULES -->

    <div class="modules">

        <span class="module active">CORE</span>
        <span class="module">RECON</span>
        <span class="module">WEBSEC</span>
        <span class="module">NETWORK</span>
        <span class="module">BLUE TEAM</span>
        <span class="module">MALWARE</span>
        <span class="module">CRYPTO</span>
        <span class="module">CLOUD</span>
        <span class="module">DFIR</span>
        <span class="module">CTF</span>

    </div>


    <!-- TOOLBAR -->

    <div class="toolbar">

        <div class="toolbar-left">

            <button class="tool-btn" onclick="clearChat()">
                CLEAR
            </button>

