/* =========================================================
   DANGEROUS REQUEST DETECTION
========================================================= */

const unsafePatterns = [

    /steal.*password/i,
    /steal.*credential/i,
    /steal.*account/i,
    /hack.*facebook/i,
    /hack.*instagram/i,
    /hack.*gmail/i,
    /hack.*account/i,
    /break.*into/i,
    /bypass.*authentication/i,
    /bypass.*login/i,
    /keylogger.*victim/i,
    /ransomware.*deploy/i,
    /malware.*deploy/i,
    /ddos.*attack/i,
    /destroy.*server/i,
    /delete.*logs/i,
    /evade.*antivirus/i,
    /disable.*antivirus/i

];


function isUnsafeRequest(question) {

    return unsafePatterns.some(
        pattern =>
            pattern.test(question)
    );
}


/* =========================================================
   FIND ANSWER
========================================================= */

function findAnswer(question) {

    if (
        isUnsafeRequest(question)
    ) {

        return `

        🛡️ <strong>Let's keep it ethical.</strong>

        <br><br>

        I can explain the cybersecurity concept,
        help you secure your own system, or show
        you how to practice the technique in an
        authorized CTF or isolated lab.

        <br><br>

        For example, you can ask:

        <br><br>

        • "How do I secure an account?"<br>
        • "How does SQL injection work?"<br>
        • "How can I detect malware?"<br>
        • "How do I build a safe security lab?"<br>
        • "How can I defend against phishing?"

        `;
    }


    const q =
        question.toLowerCase();

    let bestMatch =
        null;

    let bestScore =
        0;


    for (
        const item of knowledge
    ) {

        let score =
            0;

        for (
            const keyword of item.keywords
        ) {

            if (
                q.includes(keyword)
            ) {

                score++;
            }
        }

        if (
            score > bestScore
        ) {

            bestScore =
                score;

            bestMatch =
                item;
        }
    }


    if (bestMatch) {

        return bestMatch.answer;
    }


    return `

        🤖 <strong>CYBERAI</strong>

        <br><br>

        I don't have a specific answer for that
        in my built-in knowledge base yet.

        <br><br>

        Try asking about:

        <br><br>

        🛡️ Ethical hacking<br>
        🔐 Password security<br>
        🕸️ Web security<br>
        🌐 Network security<br>
        🐛 Malware analysis<br>
        🧪 CTFs<br>
        🔒 Cryptography<br>
        🐧 Linux security<br>
        🚨 Incident response

        <br><br>

        <span style="color:#39ff88;">
        Tip: keep experiments inside systems
        you own or have permission to test.
        </span>

    `;
}


/* =========================================================
   SEND MESSAGE
========================================================= */

async function sendMessage() {

    const question =
        input.value.trim();

    if (!question) {
        return;
    }


    addMessage(
        escapeHTML(question),
        "user"
    );


    input.value = "";


    showTyping();


    await new Promise(
        resolve =>
            setTimeout(
                resolve,
                600 +
                Math.random() * 900
            )
    );


    removeTyping();


    const answer =
        findAnswer(question);


    addMessage(
        answer,
        "bot"
    );
}


