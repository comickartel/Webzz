<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CyberAI — Cybersecurity Assistant</title>

<style>
/* =========================================================
   CYBERAI — CSS
========================================================= */

:root {
    --cyan: #00f5ff;
    --green: #39ff88;
    --blue: #168cff;
    --purple: #8b5cff;
    --red: #ff3d71;
    --dark: #03070b;
    --panel: rgba(4, 14, 20, .86);
    --border: rgba(0, 245, 255, .2);
    --text: #eaffff;
    --muted: #638087;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html,
body {
    min-height: 100%;
}

body {
    min-height: 100vh;
    overflow-x: hidden;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
    background: #020508;
}

/* =========================================================
   BACKGROUND
========================================================= */

.background {
    position: fixed;
    inset: 0;
    z-index: -10;
    overflow: hidden;

    background:
        radial-gradient(
            circle at 50% 20%,
            rgba(0, 245, 255, .09),
            transparent 28%
        ),
        radial-gradient(
            circle at 15% 85%,
            rgba(0, 255, 120, .06),
            transparent 25%
        ),
        linear-gradient(
            #041017,
            #010305
        );
}

/* Scanlines */

.scanlines {
    position: absolute;
    inset: 0;

    background:
        repeating-linear-gradient(
            to bottom,
            transparent 0,
            transparent 3px,
            rgba(0, 255, 255, .018) 4px
        );

    pointer-events: none;
}

/* Grid */

.grid {
    position: absolute;
    inset: -100%;

    opacity: .14;

    background-image:
        linear-gradient(
            rgba(0, 245, 255, .12) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(0, 245, 255, .12) 1px,
            transparent 1px
        );

    background-size: 45px 45px;

    transform:
        perspective(550px)
        rotateX(58deg);

    transform-origin: center bottom;

    animation:
        gridMove 8s linear infinite;
}

@keyframes gridMove {
    from {
        transform:
            perspective(550px)
            rotateX(58deg)
            translateY(0);
    }

    to {
        transform:
            perspective(550px)
            rotateX(58deg)
            translateY(45px);
    }
}

/* Glows */

.glow {
    position: absolute;

    width: 450px;
    height: 450px;

    border-radius: 50%;

    filter: blur(120px);

    opacity: .35;

    animation:
        glowMove 9s ease-in-out infinite alternate;
}

.glow.one {
    left: -180px;
    top: -180px;
    background: #00d9ff;
}

.glow.two {
    right: -200px;
    bottom: -200px;
    background: #0077ff;
    animation-delay: 2s;
}

@keyframes glowMove {
    from {
        transform: translate(0, 0) scale(1);
    }

    to {
        transform: translate(100px, 80px) scale(1.25);
    }
}

/* =========================================================
   PARTICLES
========================================================= */

.particles {
    position: fixed;
    inset: 0;
    z-index: -5;
    pointer-events: none;
}

.particle {
    position: absolute;

    width: 3px;
    height: 3px;

    background: var(--cyan);

    box-shadow:
        0 0 10px var(--cyan);

    animation:
        particleUp linear infinite;
}

@keyframes particleUp {
    from {
        transform: translateY(110vh);
        opacity: 0;
    }

    20% {
        opacity: .8;
    }

    80% {
        opacity: .4;
    }

    to {
        transform: translateY(-10vh);
        opacity: 0;
    }
}

/* =========================================================
   APP
========================================================= */

.app {
    width: min(1100px, 94%);
    min-height: 92vh;

    margin: 4vh auto;

    display: flex;
    flex-direction: column;

    overflow: hidden;

    background:
        var(--panel);

    border:
        1px solid var(--border);

    border-radius:
        24px;

    backdrop-filter:
        blur(20px);

    box-shadow:
        0 0 70px rgba(0, 220, 255, .08),
        inset 0 0 50px rgba(0, 245, 255, .025);
}

/* =========================================================
   HEADER
========================================================= */

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 18px 24px;

    background:
        rgba(2, 11, 16, .85);

    border-bottom:
        1px solid var(--border);
}

.brand {
    display: flex;
    align-items: center;
    gap: 15px;
}

/* =========================================================
   CYBER SHIELD LOGO
========================================================= */

.logo {
    width: 58px;
    height: 64px;

    position: relative;

    clip-path:
        polygon(
            50% 0%,
            94% 16%,
            87% 70%,
            50% 100%,
            13% 70%,
            6% 16%
        );

    background:
        linear-gradient(
            145deg,
            #00f5ff,
            #0874ff 45%,
            #07151f 46%
        );

    box-shadow:
        0 0 15px var(--cyan);

    animation:
        shieldPulse 2s infinite;
}

.logo::before {
    content: "";

    position: absolute;

    inset: 7px;

    clip-path:
        polygon(
            50% 0%,
            94% 16%,
            87% 70%,
            50% 100%,
            13% 70%,
            6% 16%
        );

    background:
        #061017;
}

/* Digital lock */

.logo::after {
    content: "01";

    position: absolute;

    left: 11px;
    top: 21px;

    color: var(--cyan);

    font-size: 13px;
    font-weight: bold;

    letter-spacing: 2px;

    text-shadow:
        0 0 8px var(--cyan);

    animation:
        textFlicker 1.5s infinite;
}

@keyframes shieldPulse {

    0%, 35%, 100% {
        transform: scale(1);

        filter:
            drop-shadow(0 0 5px #00bfff)
            drop-shadow(0 0 12px rgba(0,245,255,.35));
    }

    42% {
        transform: scale(1.09);

        filter:
            brightness(1.8)
            drop-shadow(0 0 8px #00f5ff)
            drop-shadow(0 0 28px #00aaff)
            drop-shadow(0 0 50px rgba(0,245,255,.6));
    }

    50% {
        transform: scale(1);
    }
}

@keyframes textFlicker {
    0%, 90%, 100% {
        opacity: 1;
    }

    93% {
        opacity: .25;
    }

    96% {
        opacity: 1;
    }
}

/* Brand */

.brand h1 {
    font-size: 24px;
    letter-spacing: 3px;
}

.brand h1 span {
    color: var(--cyan);

    text-shadow:
        0 0 8px var(--cyan),
        0 0 20px rgba(0,245,255,.5);
}

.brand small {
    color: var(--muted);
}

/* Status */

.status {
    display: flex;
    align-items: center;
    gap: 8px;

    color: var(--green);

    font-size: 12px;
    letter-spacing: 1px;
}

.status-dot {
    width: 9px;
    height: 9px;

    border-radius: 50%;

    background: var(--green);

    box-shadow:
        0 0 12px var(--green);

    animation:
        statusPulse 1s infinite;
}

@keyframes statusPulse {
    50% {
        opacity: .25;
        transform: scale(.7);
    }
}

/* =========================================================
   CHAT
========================================================= */

.chat {
    flex: 1;

    min-height: 500px;

    overflow-y: auto;

    padding: 28px;

    scroll-behavior: smooth;
}

.chat::-webkit-scrollbar {
    width: 7px;
}

.chat::-webkit-scrollbar-track {
    background: transparent;
}

.chat::-webkit-scrollbar-thumb {
    background: #16434b;
    border-radius: 20px;
}

.message {
    display: flex;
    gap: 12px;

    margin-bottom: 20px;

    animation:
        messageIn .3s ease;
}

@keyframes messageIn {
    from {
        opacity: 0;
        transform: translateY(10px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.message.user {
    justify-content: flex-end;
}

.avatar {
    width: 38px;
    height: 38px;

    flex-shrink: 0;

    display: grid;
    place-items: center;

    border-radius: 10px;

    background:
        #071c23;

    border:
        1px solid rgba(0,245,255,.45);

    box-shadow:
        0 0 14px rgba(0,245,255,.12);
}

.user .avatar {
    order: 2;

    background: #0d1924;

    border-color:
        rgba(80,150,255,.45);
}

.bubble {
    max-width: min(720px, 80%);

    padding: 14px 17px;

    line-height: 1.55;

    font-size: 15px;

    background:
        rgba(6, 25, 31, .85);

    border:
        1px solid rgba(0,245,255,.13);

    border-radius: 14px;

    box-shadow:
        0 10px 30px rgba(0,0,0,.18);
}

.user .bubble {
    background:
        rgba(10, 27, 43, .9);

    border-color:
        rgba(60,150,255,.2);
}

.bubble strong {
    color: var(--cyan);

    text-shadow:
        0 0 8px rgba(0,245,255,.3);
}

.bubble code {
    color: #65ffc2;

    background:
        rgba(0,0,0,.4);

    border:
        1px solid rgba(57,255,136,.12);

    padding: 2px 6px;

    border-radius: 5px;
}

/* =========================================================
   SUGGESTIONS
========================================================= */

.suggestions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;

    padding:
        0 28px 15px;
}

.suggestion {
    padding:
        9px 13px;

    color:
        #aeeff3;

    background:
        rgba(6, 29, 35, .7);

    border:
        1px solid rgba(0,245,255,.16);

    border-radius:
        999px;

    cursor:
        pointer;

    font-size:
        12px;

    transition:
        .2s;
}

.suggestion:hover {
    color: white;

    background:
        rgba(0,100,120,.5);

    border-color:
        var(--cyan);

    box-shadow:
        0 0 16px rgba(0,245,255,.18);

    transform:
        translateY(-2px);
}

/* =========================================================
   INPUT
========================================================= */

.input-area {
    padding:
        18px 24px 22px;

    border-top:
        1px solid rgba(0,245,255,.12);

    background:
        rgba(2, 9, 13, .8);
}

.input-box {
    display: flex;

    gap: 10px;

    padding: 8px;

    background:
        rgba(4, 20, 25, .95);

    border:
        1px solid rgba(0,245,255,.2);

    border-radius:
        16px;

    transition:
        .2s;
}

.input-box:focus-within {
    border-color:
        var(--cyan);

    box-shadow:
        0 0 25px rgba(0,245,255,.08);
}

#userInput {
    flex: 1;

    padding: 12px;

    color: white;

    background: transparent;

    border: none;
    outline: none;

    font-size: 15px;
}

#userInput::placeholder {
    color: #4e6970;
}

#sendBtn {
    width: 50px;
    height: 45px;

    border: none;
    border-radius: 11px;

    color: #001012;

    background:
        linear-gradient(
            135deg,
            #00f5ff,
            #2cff9b
        );

    cursor: pointer;

    font-size: 20px;
    font-weight: bold;

    box-shadow:
        0 0 18px rgba(0,245,255,.25);

    transition:
        .2s;
}

#sendBtn:hover {
    transform:
        scale(1.06);

    box-shadow:
        0 0 28px rgba(0,245,255,.5);
}

#sendBtn:active {
    transform:
        scale(.94);
}

.footer {
    margin-top: 9px;

    text-align: center;

    color: #405960;

    font-size: 10px;
}

/* =========================================================
   TYPING
========================================================= */

.typing {
    display: flex;
    gap: 5px;

    padding: 5px 2px;
}

.typing span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background:
        var(--cyan);

    box-shadow:
        0 0 8px var(--cyan);

    animation:
        typing 1s infinite;
}

.typing span:nth-child(2) {
    animation-delay: .15s;
}

.typing span:nth-child(3) {
    animation-delay: .3s;
}

@keyframes typing {
    0%, 60%, 100% {
        transform: translateY(0);
        opacity: .3;
    }

    30% {
        transform: translateY(-6px);
        opacity: 1;
    }
}

/* =========================================================
   MOBILE
========================================================= */

@media(max-width: 650px) {

    .app {
        width: 100%;
        min-height: 100vh;
        margin: 0;
        border-radius: 0;
    }

    .header {
        padding: 14px;
    }

    .brand h1 {
        font-size: 19px;
    }

    .logo {
        width: 48px;
        height: 54px;
    }

    .chat {
        padding: 18px 14px;
    }

    .suggestions {
        padding-left: 14px;
        padding-right: 14px;
    }

    .input-area {
        padding: 14px;
    }

    .bubble {
        max-width: 86%;
    }
}
</style>
</head>

