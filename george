function highlightModule(moduleName) {

    document
        .querySelectorAll(".module")
        .forEach(module => {

            module.classList.remove("active");

            if (
                module.textContent
                    .includes(moduleName)
            ) {
                module.classList.add("active");
            }

        });
}


